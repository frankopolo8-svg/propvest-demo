# Required: OpenAI API key from https://platform.openai.com/api-keys
# Server-only. Never prefix this with NEXT_PUBLIC_ or expose it to the client.
OPENAI_API_KEY=sk-proj-...

# Optional: OpenAI chat model used by the server-side multilingual chat route.
# Defaults to gpt-4.1-mini if not set.
OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional: ChatKit workflow ID for widget integration. Server-only.
OPENAI_CHATKIT_WORKFLOW_ID=wf_...

# Public-safe: ChatKit domain key. This is the only credential in this file
# that is safe to expose in the frontend bundle via NEXT_PUBLIC_.
NEXT_PUBLIC_OPENAI_CHATKIT_DOMAIN_KEY=domain_pk_...

# Optional: server-only live property inventory search. The adapter expects
# POST JSON using the PropertySearchRequest shape and a response with
# `listings` or `results`. All three variables below must be set together;
# if only some are set, live inventory search is disabled with a warning.
PROPERTY_SEARCH_API_URL=https://your-provider.example/v1/listings/search
PROPERTY_SEARCH_API_KEY=replace-with-provider-key
PROPERTY_SEARCH_PROVIDER=Your listing provider
