OPENAI_API_KEY=sk-proj-...
# Model used by the server-side multilingual chat route.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHATKIT_WORKFLOW_ID=wf_...
NEXT_PUBLIC_OPENAI_CHATKIT_DOMAIN_KEY=domain_pk_...

# Server-only live inventory provider. The adapter expects POST JSON using the
# PropertySearchRequest shape and a response with `listings` or `results`.
PROPERTY_SEARCH_API_URL=https://your-provider.example/v1/listings/search
PROPERTY_SEARCH_API_KEY=replace-with-provider-key
PROPERTY_SEARCH_PROVIDER=Your listing provider
